{
  "$ref": "#/definitions/pages",
  "definitions": {
    "pages": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "errorMessage": {
            "minLength": "Page title is required"
          }
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "errorMessage": {
            "minLength": "Page description is required"
          }
        },
        "layout": {
          "type": "string",
          "enum": [
            "default",
            "full-width",
            "sidebar",
            "landing"
          ],
          "default": "default"
        },
        "template": {
          "type": "string",
          "enum": [
            "basic",
            "hero",
            "contact",
            "about",
            "services"
          ],
          "default": "basic"
        },
        "parent": {
          "type": "string"
        },
        "menuOrder": {
          "type": "number"
        },
        "showInMenu": {
          "type": "boolean",
          "default": true
        },
        "menuLabel": {
          "type": "string"
        },
        "published": {
          "type": "boolean",
          "default": true
        },
        "publishDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "errorMessage": {
            "pattern": "Date format should be YYYY-MM-DD"
          }
        },
        "lastModified": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "errorMessage": {
            "pattern": "Date format should be YYYY-MM-DD"
          }
        },
        "seoTitle": {
          "type": "string"
        },
        "seoDescription": {
          "type": "string"
        },
        "featuredImage": {
          "type": "string",
          "format": "uri",
          "errorMessage": {
            "format": "Featured image must be a valid URL"
          }
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri",
          "errorMessage": {
            "format": "Canonical URL must be valid"
          }
        },
        "noindex": {
          "type": "boolean",
          "default": false
        },
        "sections": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "type": {
                "type": "string",
                "enum": [
                  "hero",
                  "content",
                  "gallery",
                  "contact",
                  "cta",
                  "testimonials"
                ]
              },
              "title": {
                "type": "string"
              },
              "content": {
                "type": "string"
              },
              "settings": {
                "type": "object",
                "additionalProperties": {}
              }
            },
            "required": [
              "type"
            ],
            "additionalProperties": false
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}