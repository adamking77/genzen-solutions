{
  "$ref": "#/definitions/reports",
  "definitions": {
    "reports": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "errorMessage": {
            "minLength": "Title is required"
          }
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "errorMessage": {
            "minLength": "Description must be at least 10 characters"
          }
        },
        "tldr": {
          "type": "string",
          "maxLength": 800,
          "errorMessage": {
            "maxLength": "TLDR should be concise (max 800 characters)"
          }
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "errorMessage": {
            "minLength": "Author is required"
          }
        },
        "publishDate": {
          "type": "string",
          "pattern": "^\\w+ \\d{4}$",
          "errorMessage": {
            "pattern": "Date format should be 'Month YEAR' (e.g., 'December 2024')"
          }
        },
        "category": {
          "type": "string",
          "enum": [
            "Strategic",
            "Financial",
            "Market Analysis",
            "Technology",
            "Performance",
            "Regional",
            "Intelligence",
            "Security Analysis"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "errorMessage": {
            "minItems": "At least one tag is required",
            "maxItems": "Maximum 10 tags allowed"
          },
          "maxItems": 10
        },
        "readTime": {
          "type": "string",
          "pattern": "^\\d+\\s+min\\s+read$",
          "errorMessage": {
            "pattern": "Read time format should be 'X min read'"
          }
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "published": {
          "type": "boolean",
          "default": true
        },
        "templateVersion": {
          "type": "string",
          "default": "1.0"
        },
        "lastModified": {
          "type": "string"
        },
        "featuredImage": {
          "type": "string",
          "format": "uri",
          "errorMessage": {
            "format": "Featured image must be a valid URL"
          }
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri",
          "errorMessage": {
            "format": "Canonical URL must be valid"
          }
        },
        "excerpt": {
          "type": "string",
          "maxLength": 800,
          "errorMessage": {
            "maxLength": "Excerpt should be concise (max 800 characters)"
          }
        },
        "seoTitle": {
          "type": "string"
        },
        "seoDescription": {
          "type": "string"
        },
        "executiveSummary": {
          "type": "object",
          "properties": {
            "keyPoints": {
              "type": "array",
              "items": {
                "type": "string"
              }
            },
            "recommendations": {
              "type": "object",
              "properties": {
                "immediate": {
                  "type": "string"
                },
                "shortTerm": {
                  "type": "string"
                },
                "longTerm": {
                  "type": "string"
                }
              },
              "required": [
                "immediate",
                "shortTerm",
                "longTerm"
              ],
              "additionalProperties": false
            },
            "nextReview": {
              "type": "string"
            },
            "timeline": {
              "type": "string"
            }
          },
          "required": [
            "keyPoints",
            "recommendations"
          ],
          "additionalProperties": false
        },
        "metrics": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string"
              },
              "value": {
                "type": "string"
              },
              "change": {
                "type": "string"
              },
              "period": {
                "type": "string"
              }
            },
            "required": [
              "label",
              "value",
              "change",
              "period"
            ],
            "additionalProperties": false
          }
        },
        "clientInsights": {
          "type": "object",
          "properties": {
            "title": {
              "type": "string"
            },
            "subtitle": {
              "type": "string"
            },
            "insights": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "category": {
                    "type": "string"
                  },
                  "score": {
                    "type": "string"
                  },
                  "feedback": {
                    "type": "string"
                  },
                  "statistic": {
                    "type": "string"
                  }
                },
                "required": [
                  "category",
                  "score",
                  "feedback",
                  "statistic"
                ],
                "additionalProperties": false
              }
            }
          },
          "required": [
            "insights"
          ],
          "additionalProperties": false
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "viewCount": {
          "type": "number",
          "minimum": 0
        },
        "downloadCount": {
          "type": "number",
          "minimum": 0
        },
        "components": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "ContentSplit"
                      },
                      "leftTitle": {
                        "type": "string"
                      },
                      "leftDescription": {
                        "type": "string"
                      },
                      "rightTitle": {
                        "type": "string"
                      },
                      "rightItems": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "meta": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "title",
                            "description"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "reversed": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type",
                      "leftTitle",
                      "leftDescription",
                      "rightTitle",
                      "rightItems"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "ContentSplit"
                      },
                      "leftTitle": {
                        "type": "string"
                      },
                      "leftDescription": {
                        "type": "string"
                      },
                      "rightTitle": {
                        "type": "string"
                      },
                      "rightChart": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "embedUrl": {
                            "type": "string"
                          },
                          "height": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "embedUrl"
                        ],
                        "additionalProperties": false
                      },
                      "reversed": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type",
                      "leftTitle",
                      "leftDescription",
                      "rightTitle",
                      "rightChart"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "MinimalList"
                  },
                  "title": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "meta": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "title",
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "numbered": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "title",
                  "items"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "author",
        "publishDate",
        "category",
        "tags",
        "readTime"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}