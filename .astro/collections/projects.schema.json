{
  "$ref": "#/definitions/projects",
  "definitions": {
    "projects": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "errorMessage": {
            "minLength": "Project title is required"
          }
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "errorMessage": {
            "minLength": "Project description must be at least 10 characters"
          }
        },
        "excerpt": {
          "type": "string",
          "minLength": 10,
          "errorMessage": {
            "minLength": "Project excerpt is required for listings"
          },
          "maxLength": 200
        },
        "client": {
          "type": "string"
        },
        "industry": {
          "type": "string"
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        },
        "startDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "errorMessage": {
            "pattern": "Date format should be YYYY-MM-DD"
          }
        },
        "endDate": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$",
          "errorMessage": {
            "pattern": "Date format should be YYYY-MM-DD"
          }
        },
        "status": {
          "type": "string",
          "enum": [
            "completed",
            "in-progress",
            "planned"
          ],
          "default": "completed"
        },
        "category": {
          "type": "string",
          "enum": [
            "Web Development",
            "Mobile App",
            "Design",
            "Consulting",
            "Strategy",
            "E-commerce",
            "API Development",
            "Other"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "errorMessage": {
            "minItems": "At least one tag is required",
            "maxItems": "Maximum 8 tags allowed"
          },
          "maxItems": 8
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "published": {
          "type": "boolean",
          "default": true
        },
        "order": {
          "type": "number"
        },
        "featuredImage": {
          "type": "string",
          "format": "uri",
          "errorMessage": {
            "format": "Featured image must be a valid URL"
          }
        },
        "gallery": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uri",
            "errorMessage": {
              "format": "Gallery image must be a valid URL"
            }
          },
          "default": []
        },
        "demoUrl": {
          "type": "string",
          "format": "uri",
          "errorMessage": {
            "format": "Demo URL must be valid"
          }
        },
        "repositoryUrl": {
          "type": "string",
          "format": "uri",
          "errorMessage": {
            "format": "Repository URL must be valid"
          }
        },
        "seoTitle": {
          "type": "string"
        },
        "seoDescription": {
          "type": "string"
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri",
          "errorMessage": {
            "format": "Canonical URL must be valid"
          }
        },
        "viewCount": {
          "type": "number",
          "minimum": 0
        },
        "likes": {
          "type": "number",
          "minimum": 0
        },
        "components": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "anyOf": [
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "ContentSplit"
                      },
                      "leftTitle": {
                        "type": "string"
                      },
                      "leftDescription": {
                        "type": "string"
                      },
                      "rightTitle": {
                        "type": "string"
                      },
                      "rightItems": {
                        "type": "array",
                        "items": {
                          "type": "object",
                          "properties": {
                            "title": {
                              "type": "string"
                            },
                            "description": {
                              "type": "string"
                            },
                            "meta": {
                              "type": "string"
                            }
                          },
                          "required": [
                            "title",
                            "description"
                          ],
                          "additionalProperties": false
                        }
                      },
                      "reversed": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type",
                      "leftTitle",
                      "leftDescription",
                      "rightTitle",
                      "rightItems"
                    ],
                    "additionalProperties": false
                  },
                  {
                    "type": "object",
                    "properties": {
                      "type": {
                        "type": "string",
                        "const": "ContentSplit"
                      },
                      "leftTitle": {
                        "type": "string"
                      },
                      "leftDescription": {
                        "type": "string"
                      },
                      "rightTitle": {
                        "type": "string"
                      },
                      "rightChart": {
                        "type": "object",
                        "properties": {
                          "id": {
                            "type": "string"
                          },
                          "title": {
                            "type": "string"
                          },
                          "description": {
                            "type": "string"
                          },
                          "embedUrl": {
                            "type": "string"
                          },
                          "height": {
                            "type": "string"
                          }
                        },
                        "required": [
                          "id",
                          "embedUrl"
                        ],
                        "additionalProperties": false
                      },
                      "reversed": {
                        "type": "boolean"
                      }
                    },
                    "required": [
                      "type",
                      "leftTitle",
                      "leftDescription",
                      "rightTitle",
                      "rightChart"
                    ],
                    "additionalProperties": false
                  }
                ]
              },
              {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string",
                    "const": "MinimalList"
                  },
                  "title": {
                    "type": "string"
                  },
                  "items": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "properties": {
                        "title": {
                          "type": "string"
                        },
                        "description": {
                          "type": "string"
                        },
                        "meta": {
                          "type": "string"
                        }
                      },
                      "required": [
                        "title",
                        "description"
                      ],
                      "additionalProperties": false
                    }
                  },
                  "numbered": {
                    "type": "boolean"
                  }
                },
                "required": [
                  "type",
                  "title",
                  "items"
                ],
                "additionalProperties": false
              }
            ]
          }
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "excerpt",
        "startDate",
        "category",
        "tags"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}