---
import ScrollAnimator from '../interactive/ScrollAnimator.tsx';

export interface Props {
  title: string;
  subtitle?: string;
  metrics: Array<{
    metric: string;
    value: string;
    trend: 'up' | 'down' | 'stable' | 'critical';
    description: string;
  }>;
}

const { title, subtitle, metrics } = Astro.props;
---

<section class="py-16 sm:py-20 lg:py-24 bg-secondary/30" id="performance-metrics-section">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-12">
      <div class="lg:col-span-5">
        <ScrollAnimator client:load threshold={0.2} duration={1000}>
          <div class="space-y-8 sticky top-32">
            <h2 class="text-4xl md:text-5xl font-light leading-tight tracking-tight text-foreground">
              {title}
            </h2>
            <div class="w-12 h-px bg-foreground/20"></div>
            {subtitle && (
              <p class="text-sm sm:text-base font-light text-foreground leading-relaxed">
                {subtitle}
              </p>
            )}
          </div>
        </ScrollAnimator>
      </div>

      <div class="lg:col-span-7">
        <ScrollAnimator client:load threshold={0.2} duration={1000} delay={200} staggerChildren={150}>
          <div class="grid grid-cols-1 gap-6 sm:grid-cols-3 sm:grid-rows-2 sm:gap-8 lg:gap-12">
            {metrics.map((metric, index) => {
              // Mobile: simple stacked layout, Desktop: bento grid layout
              const gridClasses = index === 0 
                ? "sm:col-span-2 sm:row-span-1 sm:col-start-1 sm:row-start-1" // S$930M - wide card (left side)
                : index === 1 
                ? "sm:col-span-3 sm:row-span-1 sm:col-start-1 sm:row-start-2" // 43% - full width bottom
                : "sm:col-span-1 sm:row-span-1 sm:col-start-3 sm:row-start-1"; // 62% - top right
              
              return (
                <div class={`group relative cursor-pointer hover:scale-105 transition-transform duration-300 ease-in-out transform-gpu ${gridClasses}`}>
                  <div class={`border-l border-foreground/10 pl-8 pr-6 hover:border-foreground/30 hover:neumorphic-hover-card hover:dark:neumorphic-hover-card-dark transition-all duration-300 ease-in-out ${index === 1 ? 'space-y-4 pt-4 pb-4' : 'space-y-6 py-6 h-full'}`}>
                    <div class="flex items-start justify-between">
                      <div class="space-y-3">
                        <div class={`font-light text-foreground transition-colors duration-300 ease-in-out ${index === 0 ? 'text-4xl lg:text-5xl' : 'text-2xl lg:text-3xl'}`}>
                          {metric.value}
                        </div>
                        <div class={`font-light text-foreground tracking-wider ${index === 0 ? 'text-base' : 'text-sm'}`}>
                          {metric.metric.toUpperCase()}
                        </div>
                      </div>
                      <div class="w-2 h-2 rounded-full bg-primary/60 transition-[transform,box-shadow] duration-300 ease-in-out group-hover:scale-125 group-hover:bg-primary group-hover:neumorphic-hover-subtle group-hover:dark:neumorphic-hover-subtle-dark flex-shrink-0" />
                    </div>
                    <p class={`font-light text-foreground/60 leading-relaxed ${index === 0 ? 'text-sm' : 'text-xs'}`}>
                      {metric.description}
                    </p>
                  </div>
                </div>
              );
            })}
          </div>
        </ScrollAnimator>
      </div>
    </div>
  </div>
</section>

