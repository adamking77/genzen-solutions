---
import ScrollAnimator from '../interactive/ScrollAnimator.tsx';

export interface Props {
  title: string;
  subtitle?: string;
  metrics: Array<{
    metric: string;
    value: string;
    trend: 'up' | 'down' | 'stable' | 'critical';
    description: string;
  }>;
}

const { title, subtitle, metrics } = Astro.props;
---

<section class="py-16 sm:py-20 lg:py-24 bg-secondary/30" id="performance-metrics-section">
  <div class="max-w-6xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="grid lg:grid-cols-12 gap-6 sm:gap-8 lg:gap-12">
      <div class="lg:col-span-5">
        <ScrollAnimator client:load threshold={0.2} duration={1000}>
          <div class="space-y-8 sticky top-32">
            <h2 class="text-2xl sm:text-3xl md:text-4xl font-light leading-tight tracking-tight text-foreground">
              {title}
            </h2>
            <div class="w-12 h-px bg-foreground/20"></div>
            {subtitle && (
              <p class="text-sm sm:text-base font-light text-foreground leading-relaxed">
                {subtitle}
              </p>
            )}
          </div>
        </ScrollAnimator>
      </div>

      <div class="lg:col-span-7">
        <ScrollAnimator client:load threshold={0.2} duration={1000} delay={200} staggerChildren={150}>
          <div class="grid grid-cols-1 sm:grid-cols-2 gap-6 sm:gap-8 md:gap-10">
            {metrics.map((metric, index) => (
              <div class="group relative cursor-pointer hover:scale-105 transition-transform duration-300 ease-in-out">
                <div class="space-y-6 border-l border-foreground/10 pl-8 hover:border-foreground/30 transition-colors duration-300 ease-in-out">
                  <div class="flex items-start justify-between">
                    <div class="space-y-3">
                      <div class="text-3xl font-light text-foreground group-hover:scale-110 transition-transform duration-300 ease-in-out">
                        {metric.value}
                      </div>
                      <div class="text-sm font-light text-foreground tracking-wider">
                        {metric.metric.toUpperCase()}
                      </div>
                    </div>
                    <div
                      class:list={[
                        "w-2 h-2 rounded-full mt-2 transition-[transform,box-shadow] duration-300 ease-in-out group-hover:scale-150",
                        {
                          'bg-foreground/80 group-hover:shadow-lg group-hover:shadow-foreground/50': metric.trend === 'up',
                          'bg-foreground/60 group-hover:shadow-lg group-hover:shadow-foreground/30': metric.trend === 'down',
                          'bg-foreground/40 group-hover:shadow-lg group-hover:shadow-foreground/20': metric.trend === 'stable',
                          'bg-red-500/80 group-hover:shadow-lg group-hover:shadow-red-500/50': metric.trend === 'critical',
                        }
                      ]}
                    />
                  </div>
                  <div class="w-full bg-foreground/5 h-2 rounded-full overflow-hidden">
                    <div
                      class="progress-bar h-full bg-gradient-to-r from-foreground to-foreground/60 transition-[width] duration-2000 ease-out rounded-full"
                      data-percentage={metric.trend === 'critical' ? '85' : '75'}
                      style={`width: 0%; transition-delay: ${index * 0.2}s;`}
                    />
                  </div>
                  <p class="text-xs font-light text-foreground/60 mt-2 leading-relaxed">
                    {metric.description}
                  </p>
                </div>
              </div>
            ))}
          </div>
        </ScrollAnimator>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const section = document.getElementById('performance-metrics-section');
    if (!section) return;

    const progressBars = section.querySelectorAll('.progress-bar');
    let hasAnimated = false;

    const observer = new IntersectionObserver((entries) => {
      entries.forEach(entry => {
        if (entry.isIntersecting && !hasAnimated) {
          progressBars.forEach(bar => {
            const progressBarElement = bar as HTMLElement;
            const percentage = progressBarElement.dataset.percentage;
            if (percentage) {
              progressBarElement.style.width = `${percentage}%`;
            }
          });
          hasAnimated = true;
          observer.unobserve(section);
        }
      });
    }, { threshold: 0.2 });

    observer.observe(section);
  });
</script>