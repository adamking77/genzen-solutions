---
interface Props {
  title: string;
  subtitle: string;
  insights: Array<{
    category: string;
    score: string;
    feedback: string;
    statistic: string;
  }>;
}

const { title, subtitle, insights = [] } = Astro.props;
// Note: animation-delay styles have been removed for this structural conversion.
---
<section class="py-32 lg:py-40 bg-background">
  <div class="max-w-7xl mx-auto px-8 lg:px-12">
    <div class="grid lg:grid-cols-12 gap-20">
      <div class="lg:col-span-4 lg:col-start-2">
        <div class="space-y-8"> {/* Removed animate-fade-in */}
          <h2 class="text-4xl md:text-5xl font-light leading-tight tracking-tight text-foreground">
            {title}
          </h2>
          <div class="w-12 h-px bg-foreground/20"></div>
          <p class="text-base font-light text-foreground/70 leading-relaxed">
            {subtitle}
          </p>
        </div>
      </div>
      
      <div class="lg:col-span-7 lg:col-start-6">
        <div class="space-y-16">
          {insights.map((insight, index) => (
            // Removed animate-fade-in class and style attribute for animationDelay
            <div class="relative group cursor-pointer hover:scale-105 transition-all duration-300">
              <div class="space-y-6 p-8 rounded-lg hover:bg-foreground/5 transition-colors duration-300">
                <div class="space-y-3">
                  <h3 class="text-xl font-light text-foreground group-hover:text-foreground/80 transition-colors duration-300">
                    {insight.category}
                  </h3>
                  <div class="flex items-baseline space-x-2">
                    <span class="text-2xl font-light text-foreground">
                      {insight.score}
                    </span>
                    <span class="text-sm font-light text-foreground/60">
                      {insight.statistic}
                    </span>
                  </div>
                </div>
                <p class="text-base font-light text-foreground/70 leading-relaxed group-hover:text-foreground transition-colors duration-300">
                  {insight.feedback}
                </p>
              </div>
              {index < insights.length - 1 && (
                <div class="w-full h-px bg-foreground/10 mt-12 transition-all duration-300 group-hover:bg-foreground/20" />
              )}
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>