---
interface Props {
  title: string;
  description: string;
  services: string[];
}

const { title, description, services } = Astro.props;
---

<section class="py-32 lg:py-40 bg-secondary/20">
  <div class="max-w-7xl mx-auto px-8 lg:px-12">
    <div class="space-y-16">
      <div class="text-center space-y-8">
        <h2 class="text-4xl md:text-5xl font-light leading-[1.1] tracking-tight text-foreground">
          {title}
        </h2>
        <div class="w-16 h-px bg-foreground/20 mx-auto"></div>
        <p class="text-lg font-light text-foreground/70 leading-relaxed max-w-3xl mx-auto">
          {description}
        </p>
      </div>

      <div class="grid lg:grid-cols-2 gap-8">
        {services.map((service) => (
          <div class="flex items-start space-x-4 p-6 bg-background/50 rounded-lg">
            <div class="w-2 h-2 rounded-full bg-primary/50 mt-3 flex-shrink-0"></div>
            <div>
              <p class="text-base font-light text-foreground/80 leading-relaxed">
                {service}
              </p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </div>
</section>