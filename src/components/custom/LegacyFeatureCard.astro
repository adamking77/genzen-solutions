---
interface Props {
  title: string;
  description: string;
  index: number;
}

const { title, description, index } = Astro.props;

const progressAngles = ['120deg', '240deg', '360deg'];
const progressAngle = progressAngles[index] || '120deg';
---

<div class="relative group cursor-pointer hover:scale-105 transition-all duration-300">
  <div class="grid grid-cols-[auto_1fr] sm:grid-cols-12 gap-4 sm:gap-6 items-start p-4 sm:p-6 rounded-lg hover:bg-foreground/5 transition-colors duration-300">
    <!-- Mobile & Desktop: Left-aligned circle -->
    <div class="relative flex items-center justify-center sm:col-span-1 sm:h-full sm:mr-4 sm:pt-1">
      <div class="relative">
        <div
          class="progress-circle-mobile sm:progress-circle"
          style={`--end-angle: ${progressAngle};`}
        >
        </div>
        <div class="text-xs sm:text-sm font-light text-foreground absolute inset-0 flex items-center justify-center pointer-events-none">
          0{index + 1}
        </div>
      </div>
    </div>
    
    <div class="sm:col-span-11">
      <div class="space-y-4">
        <h3 class="text-xl font-light text-foreground group-hover:text-foreground/90 transition-colors duration-300" set:html={title} />
        <p class="text-base font-light text-foreground/70 leading-relaxed group-hover:text-foreground transition-colors duration-300" set:html={description} />
      </div>
    </div>
  </div>
  <div class="w-full h-px bg-foreground/10 mt-6 sm:mt-8 transition-all duration-300 group-hover:bg-foreground/20" />
</div>
<style>
  @property --progress-angle {
    syntax: '<angle>';
    inherits: false;
    initial-value: 0deg;
  }

  .progress-circle-mobile {
    width: 40px;
    height: 40px;
    min-width: 40px;
    min-height: 40px;
    max-width: 40px;
    max-height: 40px;
    border-radius: 50%;
    aspect-ratio: 1;
    background: conic-gradient(
      hsl(var(--primary)) 0deg var(--progress-angle),
      hsl(var(--muted-foreground) / 0.2) var(--progress-angle) 360deg
    );
    transition: --progress-angle 0.5s ease-in-out;
    opacity: 1;
    flex-shrink: 0;
    position: relative;
  }
  
  .progress-circle-mobile::after {
    content: '';
    position: absolute;
    top: 6px;
    left: 6px;
    width: 28px;
    height: 28px;
    background: hsl(var(--background));
    border-radius: 50%;
  }

  .progress-circle {
    width: 56px;
    height: 56px;
    min-width: 56px;
    min-height: 56px;
    max-width: 56px;
    max-height: 56px;
    border-radius: 50%;
    aspect-ratio: 1;
    background: conic-gradient(
      hsl(var(--primary)) 0deg var(--progress-angle),
      hsl(var(--muted-foreground) / 0.2) var(--progress-angle) 360deg
    );
    transition: --progress-angle 0.5s ease-in-out;
    opacity: 1;
    flex-shrink: 0;
    position: relative;
  }
  
  .progress-circle::after {
    content: '';
    position: absolute;
    top: 8px;
    left: 8px;
    width: 40px;
    height: 40px;
    background: hsl(var(--background));
    border-radius: 50%;
  }

  .group:hover .progress-circle-mobile,
  .group:hover .progress-circle {
    --progress-angle: var(--end-angle);
  }
</style>