---
interface Props {
  title: string;
  description: string;
  index: number;
  isVisible?: boolean;
}

const { title, description, index, isVisible = false } = Astro.props;

const progressAngles = ['120deg', '240deg', '360deg'];
const progressAngle = progressAngles[index] || '120deg';
const progressPercent = ((parseInt(progressAngle) / 360) * 100);
---

<div class="relative group cursor-pointer hover:scale-105 transition-all duration-300">
  <div class="grid grid-cols-[auto_1fr] sm:grid-cols-12 gap-4 sm:gap-6 items-start p-4 sm:p-6 rounded-lg hover:bg-foreground/5 transition-colors duration-300">
    <!-- Mobile & Desktop: Left-aligned circle -->
    <div class="relative flex items-center justify-center sm:col-span-1 sm:h-full sm:mr-4 sm:pt-1">
      <div class="progress-circle-container" data-progress={index} data-animate={isVisible}>
        <!-- Mobile SVG -->
        <svg class="progress-svg-mobile sm:hidden" viewBox="0 0 40 40" width="40" height="40">
          <circle
            class="progress-background"
            cx="20"
            cy="20"
            r="18"
            fill="none"
            stroke="hsl(var(--muted-foreground) / 0.2)"
            stroke-width="1.5"
          />
          <circle
            class="progress-foreground"
            cx="20"
            cy="20"
            r="18"
            fill="none"
            stroke="hsl(var(--primary))"
            stroke-width="1.5"
            stroke-linecap="round"
            transform="rotate(-90 20 20)"
            style="stroke-dasharray: 113.097; stroke-dashoffset: 113.097;"
          />
        </svg>
        <!-- Desktop SVG -->
        <svg class="hidden sm:block progress-svg" viewBox="0 0 56 56" width="56" height="56">
          <circle
            class="progress-background"
            cx="28"
            cy="28"
            r="26"
            fill="none"
            stroke="hsl(var(--muted-foreground) / 0.2)"
            stroke-width="2"
          />
          <circle
            class="progress-foreground"
            cx="28"
            cy="28"
            r="26"
            fill="none"
            stroke="hsl(var(--primary))"
            stroke-width="2"
            stroke-linecap="round"
            transform="rotate(-90 28 28)"
            style="stroke-dasharray: 163.363; stroke-dashoffset: 163.363;"
          />
        </svg>
        <div class="progress-number">0{index + 1}</div>
      </div>
    </div>
    
    <div class="sm:col-span-11">
      <div class="space-y-4">
        <h3 class="text-xl font-light text-foreground group-hover:text-foreground/90 transition-colors duration-300" set:html={title} />
        <p class="text-base font-light text-foreground/70 leading-relaxed group-hover:text-foreground transition-colors duration-300" set:html={description} />
      </div>
    </div>
  </div>
  <div class="w-full h-px bg-foreground/10 mt-6 sm:mt-8 transition-all duration-300 group-hover:bg-foreground/20" />
</div>
<style is:global>
  .progress-circle-container {
    position: relative;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .progress-foreground {
    transition: stroke-dashoffset 0.8s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .progress-number {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    font-size: 0.75rem;
    font-weight: 300;
    color: hsl(var(--foreground));
    line-height: 1;
  }

  @media (min-width: 640px) {
    .progress-number {
      font-size: 0.875rem;
    }
  }

  /* Scroll-triggered animations - Updated selectors */
  .progress-circle-container[data-animate="true"][data-progress="0"] .progress-foreground {
    stroke-dashoffset: 75.398; /* Mobile: 113.097 * 0.667 - 33% progress */
  }

  .progress-circle-container[data-animate="true"][data-progress="1"] .progress-foreground {
    stroke-dashoffset: 37.699; /* Mobile: 113.097 * 0.333 - 67% progress */
  }

  .progress-circle-container[data-animate="true"][data-progress="2"] .progress-foreground {
    stroke-dashoffset: 0; /* Full circle - 100% progress */
  }

  /* Desktop adjustments */
  @media (min-width: 640px) {
    .progress-circle-container[data-animate="true"][data-progress="0"] .progress-foreground {
      stroke-dashoffset: 108.909; /* Desktop: 163.363 * 0.667 - 33% progress */
    }

    .progress-circle-container[data-animate="true"][data-progress="1"] .progress-foreground {
      stroke-dashoffset: 54.454; /* Desktop: 163.363 * 0.333 - 67% progress */
    }

    .progress-circle-container[data-animate="true"][data-progress="2"] .progress-foreground {
      stroke-dashoffset: 0; /* Full circle - 100% progress */
    }
  }

  /* Maintain hover effects as secondary interaction */
  .group:hover [data-progress="0"] .progress-foreground {
    stroke-dashoffset: 75.398;
  }

  .group:hover [data-progress="1"] .progress-foreground {
    stroke-dashoffset: 37.699;
  }

  .group:hover [data-progress="2"] .progress-foreground {
    stroke-dashoffset: 0;
  }

  @media (min-width: 640px) {
    .group:hover [data-progress="0"] .progress-foreground {
      stroke-dashoffset: 108.909;
    }

    .group:hover [data-progress="1"] .progress-foreground {
      stroke-dashoffset: 54.454;
    }

    .group:hover [data-progress="2"] .progress-foreground {
      stroke-dashoffset: 0;
    }
  }
</style>