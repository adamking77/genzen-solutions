---
import ScrollAnimator from '../interactive/ScrollAnimator.tsx';

interface Statistic {
  label: string;
  value: string;
  description: string;
}

interface Props {
  title: string;
  statistics: Statistic[];
  footerText: string;
}

const { title, statistics, footerText } = Astro.props;
---

<section class="py-20 lg:py-32">
  <div class="max-w-7xl mx-auto px-8 lg:px-12">
    <div class="text-center mb-16">
      <h2 class="text-4xl md:text-5xl font-light tracking-tight text-foreground">
        {title}
      </h2>
      <div class="w-16 h-px bg-foreground/20 mx-auto mt-8"></div>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-3 gap-8 mb-16">
      {statistics.map((stat, index) => (
        <ScrollAnimator client:load threshold={0.2} duration={800} delay={index * 150}>
          <div class="bg-foreground/5 p-8 rounded-lg text-center h-full flex flex-col justify-center">
            <p class="text-5xl lg:text-6xl font-light text-primary mb-4">{stat.value}</p>
            <h3 class="text-lg font-light text-foreground mb-2">{stat.label}</h3>
            <p class="text-sm font-light text-foreground/60 leading-relaxed">{stat.description}</p>
          </div>
        </ScrollAnimator>
      ))}
    </div>

    <div class="text-center max-w-3xl mx-auto">
      <p class="text-lg font-light text-foreground/70 leading-relaxed">
        {footerText}
      </p>
    </div>
  </div>
</section>
