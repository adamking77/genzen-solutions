---
import { Image } from 'astro:assets';

interface Props {
  companyName: string;
  companyStory: string;
  founderName: string;
  founderStory: string;
  founderImage: string;
}

const { companyName, companyStory, founderName, founderStory, founderImage } = Astro.props;
---

<section class="py-24 lg:py-32 bg-background text-foreground">
  <div class="max-w-7xl mx-auto px-6 lg:px-8">
    <div class="grid lg:grid-cols-2 gap-16 lg:gap-24 items-center">
      <div class="space-y-8">
        <h2 class="text-3xl font-light tracking-tight text-foreground sm:text-4xl">
          About {companyName}
        </h2>
        <p class="text-base font-light text-foreground/70 leading-relaxed">
          {companyStory}
        </p>
      </div>
      <div class="space-y-8">
        <div class="flex items-center gap-6">
          <Image src={founderImage} alt={founderName} width={80} height={80} class="rounded-full" />
          <div>
            <h3 class="text-xl font-light text-foreground">{founderName}</h3>
            <p class="text-sm font-light text-foreground/60">Founder & CEO</p>
          </div>
        </div>
        <p class="text-base font-light text-foreground/70 leading-relaxed">
          {founderStory}
        </p>
      </div>
    </div>
  </div>
</section>