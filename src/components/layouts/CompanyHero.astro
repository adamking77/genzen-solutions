---
import ScrollAnimator from '../interactive/ScrollAnimator.tsx';
import IntakeFormModal from '../modals/IntakeFormModal.tsx';
import { Button } from '../ui/button.tsx';

interface Props {
  title: string;
  subtitle?: string;
  location: string;
  ctaText: string;
  ctaLink?: string; // Made optional since we're using modal
}

const { 
  title, 
  subtitle,
  location,
  ctaText,
  ctaLink
} = Astro.props;
---

<section class="company-hero-section pt-32 pb-24 sm:pt-40 sm:pb-32 lg:pt-48 lg:pb-40 bg-background text-foreground">
  <div class="max-w-6xl mx-auto px-6 lg:px-8">
    <div class="space-y-8 sm:space-y-10 lg:space-y-12">
      <div>
        <ScrollAnimator client:load threshold={0.2} duration={1000}>
          <h1 class="text-3xl sm:text-4xl md:text-5xl lg:text-6xl font-light leading-tight tracking-tight max-w-5xl text-foreground">
            {title} <span class="text-foreground/50">{location}</span>
          </h1>
        </ScrollAnimator>
      </div>
      
      {subtitle && (
        <div>
          <ScrollAnimator client:load threshold={0.2} duration={1000} delay={200}>
            <p class="text-base sm:text-lg md:text-xl font-light text-foreground/70 leading-relaxed max-w-2xl">
              {subtitle}
            </p>
          </ScrollAnimator>
        </div>
      )}
      
      <div>
        <ScrollAnimator client:load threshold={0.2} duration={1000} delay={400}>
          <IntakeFormModal client:load>
            <Button size="lg" className="font-light text-base px-12 py-3 h-auto border-2 border-foreground/20 bg-transparent text-foreground hover:border-primary hover:bg-primary hover:text-primary-foreground hover:scale-105 transition-[border-color,background-color,color,transform] duration-300 ease-in-out rounded-full">{ctaText}</Button>
          </IntakeFormModal>
        </ScrollAnimator>
      </div>
    </div>
  </div>
</section>

