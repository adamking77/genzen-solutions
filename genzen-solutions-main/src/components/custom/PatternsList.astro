---
interface Pattern {
  title: string;
  description: string;
}

interface Props {
  title: string;
  patterns: Pattern[];
  closingText: string;
}

const { title, patterns, closingText } = Astro.props;
---

<section class="py-20 lg:py-32 bg-foreground/5">
  <div class="max-w-5xl mx-auto px-8 lg:px-12">
    <div class="grid grid-cols-12 gap-16">
      <div class="col-span-12 lg:col-span-4">
        <div class="sticky top-32">
          <h2 class="text-3xl font-light tracking-tight text-foreground mb-8">
            {title}
          </h2>
          <div class="w-12 h-px bg-foreground/20"></div>
        </div>
      </div>
      
      <div class="col-span-12 lg:col-span-8">
        <div class="space-y-12">
          {patterns.map((pattern, index) => (
            <div class="group">
              <div class="flex items-start space-x-8 py-8 border-b border-foreground/10 last:border-b-0">
                <div class="text-lg font-light text-foreground/30 w-8 flex-shrink-0">
                  {String(index + 1).padStart(2, '0')}
                </div>
                <div class="flex-1 space-y-3">
                  <h3 class="text-xl font-light text-foreground group-hover:text-primary transition-colors duration-300">
                    {pattern.title}
                  </h3>
                  <p class="text-base font-light text-foreground/70 leading-relaxed">
                    {pattern.description}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
        
        <div class="pt-16 text-center">
          <p class="text-lg font-light text-foreground/70 leading-relaxed">
            {closingText}
          </p>
        </div>
      </div>
    </div>
  </div>
</section>