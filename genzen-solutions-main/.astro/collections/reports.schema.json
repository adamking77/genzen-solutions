{
  "$ref": "#/definitions/reports",
  "definitions": {
    "reports": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "slug": {
          "type": "string"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "errorMessage": {
            "minLength": "Title is required"
          }
        },
        "subtitle": {
          "type": "string"
        },
        "description": {
          "type": "string",
          "minLength": 10,
          "errorMessage": {
            "minLength": "Description must be at least 10 characters"
          }
        },
        "excerpt": {
          "type": "string",
          "maxLength": 500,
          "errorMessage": {
            "maxLength": "Excerpt should be concise"
          }
        },
        "tldr": {
          "type": "string",
          "maxLength": 800,
          "errorMessage": {
            "maxLength": "TLDR should be concise"
          }
        },
        "author": {
          "type": "string",
          "minLength": 1,
          "errorMessage": {
            "minLength": "Author is required"
          }
        },
        "publishDate": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^\\w+ \\d{4}$",
              "errorMessage": {
                "pattern": "Date format: 'Month YEAR'"
              }
            },
            {
              "anyOf": [
                {
                  "type": "string",
                  "format": "date-time"
                },
                {
                  "type": "string",
                  "format": "date"
                },
                {
                  "type": "integer",
                  "format": "unix-time"
                }
              ]
            }
          ]
        },
        "lastModified": {
          "anyOf": [
            {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "type": "string",
                  "format": "date-time"
                }
              ]
            },
            {
              "anyOf": [
                {
                  "not": {}
                },
                {
                  "anyOf": [
                    {
                      "type": "string",
                      "format": "date-time"
                    },
                    {
                      "type": "string",
                      "format": "date"
                    },
                    {
                      "type": "integer",
                      "format": "unix-time"
                    }
                  ]
                }
              ]
            }
          ]
        },
        "category": {
          "type": "string",
          "enum": [
            "Strategic",
            "Financial",
            "Market Analysis",
            "Technology",
            "Performance",
            "Regional"
          ]
        },
        "tags": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1,
          "maxItems": 10
        },
        "readTime": {
          "type": "string",
          "pattern": "^\\d+\\s+min\\s+read$"
        },
        "difficulty": {
          "type": "string",
          "enum": [
            "Beginner",
            "Intermediate",
            "Advanced"
          ]
        },
        "language": {
          "type": "string",
          "default": "en"
        },
        "published": {
          "type": "boolean",
          "default": true
        },
        "featured": {
          "type": "boolean",
          "default": false
        },
        "draft": {
          "type": "boolean",
          "default": false
        },
        "featuredImage": {
          "type": "string",
          "format": "uri"
        },
        "featuredImageAlt": {
          "type": "string"
        },
        "socialImage": {
          "type": "string",
          "format": "uri"
        },
        "canonicalUrl": {
          "type": "string",
          "format": "uri"
        },
        "technologies": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "services": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "contentSource": {
          "type": "string",
          "enum": [
            "local",
            "cms",
            "api"
          ],
          "default": "local"
        },
        "cmsId": {
          "type": "string"
        },
        "version": {
          "type": "string",
          "default": "1.0"
        },
        "viewCount": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "downloadCount": {
          "type": "number",
          "minimum": 0,
          "default": 0
        },
        "engagement": {
          "type": "number",
          "minimum": 0,
          "maximum": 100
        },
        "$schema": {
          "type": "string"
        }
      },
      "required": [
        "title",
        "description",
        "author",
        "publishDate",
        "category",
        "tags",
        "readTime"
      ],
      "additionalProperties": false
    }
  },
  "$schema": "http://json-schema.org/draft-07/schema#"
}