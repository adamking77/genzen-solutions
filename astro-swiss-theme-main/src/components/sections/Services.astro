---
const services = [
  {
    number: "01",
    title: "Strategic Planning",
    description: "Comprehensive strategic frameworks that align organizational vision with executable roadmaps"
  },
  {
    number: "02", 
    title: "Data Analytics",
    description: "Transform raw data into actionable insights for informed decision-making"
  },
  {
    number: "03",
    title: "Process Optimization",
    description: "Streamline operations and maximize organizational performance"
  },
  {
    number: "04",
    title: "Digital Transformation",
    description: "Modernize workflows and enhance competitive positioning"
  },
  {
    number: "05",
    title: "Change Management",
    description: "Guide organizations through transitions while maintaining excellence"
  }
];
---

<section id="services" class="py-16 lg:py-32 xl:py-40">
  <div class="max-w-5xl mx-auto px-4 md:px-8 lg:px-16 xl:px-20">
    <div class="grid lg:grid-cols-12 gap-8 lg:gap-16 xl:gap-24">
      <div class="lg:col-span-4">
        <div class="sticky top-20 lg:top-24">
          <h2 class="text-3xl md:text-4xl lg:text-5xl font-light leading-tight tracking-tight text-foreground">
            Services
          </h2>
          <div class="w-12 h-px bg-foreground/20 mt-8"></div>
        </div>
      </div>

      <div class="lg:col-span-8">
        <div class="space-y-16">
          {services.map((service, index) => (
            <div 
              class="group"
              data-animate="service-item"
              data-delay={index * 100}
            >
              <div class="grid grid-cols-12 gap-4 lg:gap-8 items-start py-6 lg:py-8 border-b border-foreground/10 last:border-b-0 group-hover:border-accent dark:group-hover:border-[hsl(var(--accent-bright))] group-hover:scale-105 group-hover:shadow-md dark:group-hover:shadow-xl dark:group-hover:shadow-[hsl(var(--shadow-medium))]/40 group-hover:bg-gradient-to-r group-hover:from-background group-hover:to-accent/30 dark:group-hover:from-[hsl(var(--background))] dark:group-hover:to-[hsl(var(--background-elevated))] transition-all duration-300 rounded-lg px-4 lg:px-6 cursor-pointer">
                <div class="col-span-2">
                  <span class="text-lg font-light text-foreground/30 group-hover:text-foreground/50 transition-colors duration-300">
                    {service.number}
                  </span>
                </div>
                <div class="col-span-10 space-y-4">
                  <h3 class="text-xl font-light text-foreground group-hover:text-foreground/80 transition-colors duration-300">
                    {service.title}
                  </h3>
                  <p class="text-sm font-light text-foreground leading-relaxed max-w-lg">
                    {service.description}
                  </p>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.addEventListener('astro:page-load', () => {
    const observerOptions = {
      threshold: 0.2,
      rootMargin: '0px'
    };

    // Animate service items only
    const serviceItems = document.querySelectorAll('[data-animate="service-item"]');
    serviceItems.forEach(element => {
      element.classList.add('opacity-0', 'translate-y-8', 'transition-all', 'duration-700', 'ease-out');
      
      const delay = parseInt(element.getAttribute('data-delay') || '0');
      const itemObserver = new IntersectionObserver((entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting) {
            const target = entry.target as HTMLElement;
            setTimeout(() => {
              target.classList.remove('opacity-0', 'translate-y-8');
              target.classList.add('opacity-100', 'translate-y-0');
            }, delay);
          }
        });
      }, observerOptions);

      itemObserver.observe(element);
    });
  });
</script>

